---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";

const { user } = Astro.locals;
---

<Layout>
  <div class="bg-cosmic min-h-screen w-full p-4 sm:p-8">
    <Topbar />
    <main class="mx-auto flex max-w-2xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text text-5xl leading-tight font-bold text-transparent sm:text-6xl">
        MealAdapt
      </h1>
      <p class="mb-10 max-w-xl text-lg text-blue-100/70 sm:text-xl">
        Zapisz produkty, których nie jesz, a MealAdapt dopasuje do nich propozycje posiłków.
      </p>
      {user ? (
        <a
          href="/exclusions"
          class="inline-flex min-h-11 items-center justify-center rounded-lg bg-purple-600 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-purple-500"
        >
          Zarządzaj wykluczeniami
        </a>
      ) : (
        <div class="flex flex-col gap-4 sm:flex-row">
          <a
            href="/auth/signin"
            class="inline-flex min-h-11 items-center justify-center rounded-lg bg-purple-600 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-purple-500"
          >
            Zaloguj się
          </a>
          <a
            href="/auth/signup"
            class="inline-flex min-h-11 items-center justify-center rounded-lg border border-white/20 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-white/10"
          >
            Załóż konto
          </a>
        </div>
      )}
    </main>
  </div>
</Layout>
