---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { ServerError } from "@/components/ServerError";
import ExclusionsManager from "@/components/exclusions/ExclusionsManager";
import { getSelectableExclusions } from "@/lib/catalog/selectable-exclusions";
import { logServerError } from "@/lib/log";
import { listExclusions } from "@/lib/services/exclusions";
import { createClient } from "@/lib/supabase";
import type { ExclusionDTO } from "@/types";

// The middleware redirects anonymous users, so `user` is always set here.
const { user } = Astro.locals;

const LOAD_ERROR = "Nie udało się wczytać Twoich wykluczeń. Odśwież stronę lub spróbuj ponownie później.";

let exclusions: ExclusionDTO[] | null = null;
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase && user) {
  try {
    exclusions = await listExclusions(supabase, user.id);
  } catch (error) {
    logServerError("page", "list exclusions", error);
  }
}
const selectableExclusions = getSelectableExclusions();
---

<Layout title="Wykluczenia">
  <div class="bg-cosmic min-h-screen p-4">
    <main class="mx-auto w-full max-w-2xl">
      <Topbar />
      <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Wykluczenia
      </h1>
      <p class="mb-6 text-sm text-blue-100/70">Wybierz produkty, których nie chcesz w swoich posiłkach.</p>
      {exclusions ? (
        <ExclusionsManager initialExclusions={exclusions} selectableExclusions={selectableExclusions} client:load />
      ) : (
        <div role="alert">
          <ServerError message={LOAD_ERROR} />
        </div>
      )}
    </main>
  </div>
</Layout>
